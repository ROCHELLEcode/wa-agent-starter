# ─────────────────────────────────────────────────────────────
# wa-agent-starter — variables de entorno
# Copiá este archivo a .env y completá lo que uses. El .env NUNCA se sube.
#
# Para el DEMO no necesitás casi nada: solo OPENROUTER_API_KEY.
#   npm run demo   (web, CHANNEL_ADAPTER=web + STORE=memory)
#   npm run chat   (terminal)
# ─────────────────────────────────────────────────────────────

# ── Núcleo ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Persistencia. 'memory' = todo en RAM (demo, sin DB). 'postgres' = persistente.
STORE=memory
# Solo si STORE=postgres:
# DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# Cola de mensajes (solo la usan los canales por webhook). El demo web no la usa.
REDIS_URL=redis://localhost:6379

# Qué frontend está activo: web | cloud-api | ghl | chatwoot | ycloud
CHANNEL_ADAPTER=web

# Secreto compartido para validar webhooks (los canales que lo usan, p.ej. GHL).
# Generá uno con:  openssl rand -hex 32
WEBHOOK_SECRET=

# ── LLM (OpenRouter) ──────────────────────────────────────────
# API key: https://openrouter.ai/keys   ← lo ÚNICO imprescindible para el demo
OPENROUTER_API_KEY=
# Cualquier modelo de OpenRouter con tool calling: anthropic/claude-sonnet-4.5,
# openai/gpt-4.1-mini, google/gemini-2.5-flash, etc.
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
APP_TITLE=wa-agent-starter

# ── Agente ────────────────────────────────────────────────────
AGENT_CONFIG_PATH=config/agent.yaml
# Espera tras el último mensaje antes de responder (junta los mensajitos sueltos).
MESSAGE_DEBOUNCE_MS=8000
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_HISTORY_LIMIT=40
# false = corre el agente pero NO envía (modo observación).
AGENT_REPLY_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Variables por canal. Completá SOLO las del canal que uses.
# ─────────────────────────────────────────────────────────────

# ── WhatsApp Cloud API (CHANNEL_ADAPTER=cloud-api) ────────────
# Meta for Developers → tu app → WhatsApp → API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# El verify token lo inventás vos y lo repetís en el dashboard de Meta.
META_VERIFY_TOKEN=
# Opcional: si lo ponés, se valida la firma HMAC de cada webhook.
META_APP_SECRET=

# ── GoHighLevel (CHANNEL_ADAPTER=ghl) ─────────────────────────
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ── Chatwoot (CHANNEL_ADAPTER=chatwoot) — stub ────────────────
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=

# ── YCloud (CHANNEL_ADAPTER=ycloud) ────────────────────────────
YCLOUD_API_KEY=
# Tu número de WhatsApp Business en YCloud, formato E.164 (ej: +51987654321).
YCLOUD_FROM_NUMBER=
# Opcional: el "secret" que te da YCloud al crear el webhook (Developers →
# Webhooks). Si lo ponés, se valida la firma de cada request entrante.
YCLOUD_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Deploy a Coolify (solo para `npm run deploy`, no lo usa la app)
# ─────────────────────────────────────────────────────────────
# COOLIFY_URL=https://coolify.tu-dominio.com
# COOLIFY_API_TOKEN=
# GITHUB_TOKEN=
# GITHUB_REPO=https://github.com/tu-usuario/tu-repo.git
